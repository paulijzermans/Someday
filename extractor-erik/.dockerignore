# .dockerignore — keeps the Docker build context lean

# Git and CI
.git/
.gitignore
.github/
.claude/

# Development artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# macOS
.DS_Store

# Credentials — never bake into image; set as Railway env vars
.env
.env.local
*.xcconfig

# iOS app (not needed in the container)
app/
seed/
db/
docs/
inspiration/
assets/
benchmark_*.py

# Extractor test app cache (mounted as Railway volume)
extractor-test-app/cache/
extractor-test-app/places.db
extractor-test-app/ui.html   # overwritten by COPY in Dockerfile

# Partial downloads
*.part
