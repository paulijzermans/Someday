<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required bundle keys (normally auto-generated by Xcode when
         GENERATE_INFOPLIST_FILE is YES; we manage them by hand so we can
         add CFBundleURLTypes below). -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Someday</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Contacts permission — used by the "Find friends on Someday"
         flow in onboarding. The string is shown verbatim by the OS in
         the permission prompt and is reviewed by Apple, so it must
         describe the specific use, not a vague benefit. -->
    <key>NSContactsUsageDescription</key>
    <string>Someday checks your contacts to find which of your loved ones already have the app. We hash phone numbers and emails on your device — your contacts never leave your phone in raw form.</string>

    <!-- Location permission — used by the "locate me" button under the
         profile avatar to recenter the map on the user's current spot.
         Only requested when the user taps the button; never collected
         in the background. Apple reviews this string verbatim, so it
         must describe the user-visible action, not a vague benefit. -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Someday uses your location only when you tap the "Locate me" button to recenter the map on where you are. Your location is never tracked or stored.</string>

    <!-- Microphone permission — used by the mic button in the AI chat
         bar to dictate questions instead of typing. The mic only
         activates when the user taps the button; audio isn't recorded
         in the background or saved anywhere. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Someday uses the microphone only when you tap the mic button to dictate a question to the AI assistant. Audio is processed on-device by Apple's speech recognition and never stored.</string>

    <!-- Speech recognition permission — paired with the microphone
         permission above for on-device transcription of the user's
         dictated question into the AI chat input. -->
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Someday transcribes what you say to the AI assistant so you can ask questions hands-free. Recognition runs on-device via Apple's speech framework and the transcript is only used to fill the chat input.</string>

    <!-- Custom font registration -->
    <key>UIAppFonts</key>
    <array>
        <string>Gondens-DEMO.otf</string>
    </array>

    <!-- Lifecycle: scene manifest + launch screen generated by Xcode -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict/>

    <!-- Orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Custom URL scheme so the Share Extension (and Safari, etc.) can
         open Someday with a pending import via `someday://import?url=…`. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.paulijzermans.someday</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>someday</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
