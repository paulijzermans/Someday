<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to `Secrets.plist` (same folder) and fill in real values.
  `Secrets.plist` is gitignored so credentials never get committed.
  Use ONLY the anon/public key here — never the service-role key.
-->
<plist version="1.0">
<dict>
    <key>SUPABASE_URL</key>
    <string>YOUR_PROJECT_URL</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_ANON_KEY</string>

    <!-- chat-service (FastAPI on Railway). The AI chat runs here, NOT in the
         Supabase `chat` Edge Function (the Deno runtime hung on web_search /
         Anthropic EOF — see chat-service/main.py header). When both keys are
         present, ChatService streams from this URL with the shared secret in
         the `X-API-Key` header; otherwise it falls back to the Supabase
         function. CHAT_SERVICE_API_KEY must match API_KEY set on Railway. -->
    <key>CHAT_SERVICE_URL</key>
    <string>YOUR_CHAT_SERVICE_URL</string>
    <key>CHAT_SERVICE_API_KEY</key>
    <string>YOUR_CHAT_SERVICE_API_KEY</string>

    <!-- Pipeline 2 (Erik's Railway video extractor). Optional — Pipeline 1
         (Supabase Edge Functions) keeps working without these. Pipeline 2
         is activated by writing "pipeline_2" to UserDefaults key
         `extraction.pipeline` (see ExtractionPipelineSelector). -->
    <key>EXTRACTOR_URL</key>
    <string>YOUR_EXTRACTOR_URL</string>
    <key>EXTRACTOR_API_KEY</key>
    <string>YOUR_EXTRACTOR_API_KEY</string>
</dict>
</plist>
