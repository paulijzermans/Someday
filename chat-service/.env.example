# Copy to .env and fill in. The .env file is gitignored — never commit real keys.
#
# Required:
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY      # the model API key (Claude Haiku 4.5)

# Optional — protects POST /chat with a shared secret. Leave unset for local dev
# (no auth). When set, the iOS app must send the same value as X-API-Key.
API_KEY=
